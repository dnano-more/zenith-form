# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# JWT Session Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Google OAuth Credentials (Optional - Guest login works out of the box)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/authentication/google/callback

# Backend Server Configuration
PORT=8000
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Frontend Next.js API Connection URL (Points to Express tRPC Endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
